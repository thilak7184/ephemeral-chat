{
  "name": "ephemeral-chat",
  "version": "1.0.0",
  "private": true,
  "description": "Temporary, end-to-end encrypted two-person chat with in-memory rooms.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev --workspace=server\" \"npm:dev --workspace=client\"",
    "start": "npm run start --workspace=server",
    "build": "npm run build --workspace=client",
    "test": "npm run test --workspace=server && npm run test --workspace=client",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md,yml,yaml}\"",
    "check": "npm run lint && npm run format:check && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=22"
  }
}
